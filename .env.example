DATABASE_URL=postgresql://user:password@localhost:5432/telegram_memory
BOT_TOKEN=paste-your-telegram-bot-token-here
WEBHOOK_SECRET=use-a-long-random-secret
# Optional locally or for a custom domain; Render uses RENDER_EXTERNAL_URL automatically.
WEBHOOK_BASE_URL=https://your-public-domain.example.com
# Optional; defaults to WEBHOOK_BASE_URL/health or Render's public URL/health.
SELF_PING_URL=https://your-public-domain.example.com/health
# Optional; default is 300000 milliseconds (5 minutes).
SELF_PING_INTERVAL_MS=300000
PORT=10000
